{
  "expo": {
    "name": "PH Weather Dashboard",
    "slug": "PHWeatherDashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gwd_logo1_non_transp.png",
    "scheme": "phweatherdashboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gwd_logo1_non_transp.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gwd_logo1_non_transp.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ezekiel.phweatherdashboard"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
